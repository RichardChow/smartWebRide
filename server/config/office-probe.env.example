# Copy to server/config/office-probe.env on trex201 and keep the real file untracked.
export SWR_ENVIRONMENT_PROBE=office
export SWR_OFFICE_PROBE_CONFIG=/path/to/smartWebRide/server/config/office-probe.json
export SWR_ENVIRONMENT_STATUS_TTL_SECONDS=15

# Jenkins credentials stay in environment variables, not JSON config.
export SWR_JENKINS_USER='<jenkins-user>'
export SWR_JENKINS_TOKEN='<jenkins-api-token-or-password>'
